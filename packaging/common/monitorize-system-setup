"""Root-only helper for selected Monitorize first-run setup actions."""

import argparse
import ctypes
import errno
import grp
import json
import mmap
import os
import pwd
import stat
import subprocess
import sys
from pathlib import Path

KMS_SETUP_PROTOCOL = 1
REMOTE_LOGIN_RECOVERY_PROTOCOL = 1
SYSTEM_RECOVERY_PROTOCOL = 1
VKMS_MANAGEMENT_PROTOCOL = 1


def grant_kms_capability(binary, device, inode):
    """Grant only CAP_SYS_ADMIN permitted, on the authenticated, opened engine inode."""
    username = invoking_user()
    uid = pwd.getpwnam(username).pw_uid
    path = Path(binary)
    if not path.is_absolute() or path != path.resolve(strict=True):
        raise RuntimeError('Select the canonical Monitorize Sunshine executable, without symlinks.')
    packaged = path == Path('/usr/libexec/monitorize/sunshine')
    source_root = None
    if path.parts[-4:] == ('linux', 'venv', 'bin', 'sunshine'):
        source_root = path.parents[3]
    elif path.parts[-4:] == ('external', 'sunshine', 'build', 'sunshine'):
        source_root = path.parents[3]
    if not packaged and (source_root is None
                         or not (source_root / 'linux/monitorize/platform/sunshine_service.py').is_file()
                         or not (source_root / '.gitmodules').is_file()):
        raise RuntimeError('KMS permission repair accepts only a Monitorize source or packaged Sunshine engine.')
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        info = os.fstat(descriptor)
        if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1
                or info.st_uid != (0 if packaged else uid)
                or info.st_mode & 0o022 or not info.st_mode & 0o111
                or (info.st_dev, info.st_ino) != (device, inode)):
            raise RuntimeError('The Sunshine executable changed or has unsafe ownership/permissions. Retry from Monitorize.')
        if os.pread(descriptor, 4, 0) != b'\x7fELF':
            raise RuntimeError('The selected Sunshine engine is not an ELF executable.')
        with mmap.mmap(descriptor, 0, access=mmap.ACCESS_READ) as image:
            if image.find(b'MONITORIZE_CODEC_PROBE_FAILED') < 0:
                raise RuntimeError('The selected executable is not a Monitorize Sunshine engine.')
        # File-descriptor capability operations bind authorization to the checked
        # inode. Never execute a user-writable binary or resolve its path again
        # in a privileged setcap subprocess.
        lib = ctypes.CDLL('libcap.so.2', use_errno=True)
        lib.cap_get_fd.argtypes = [ctypes.c_int]
        lib.cap_get_fd.restype = ctypes.c_void_p
        lib.cap_init.restype = ctypes.c_void_p
        lib.cap_set_flag.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int,
                                    ctypes.POINTER(ctypes.c_int), ctypes.c_int]
        lib.cap_set_fd.argtypes = [ctypes.c_int, ctypes.c_void_p]
        lib.cap_get_flag.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.c_int)]
        lib.cap_free.argtypes = [ctypes.c_void_p]
        caps = lib.cap_get_fd(descriptor)
        if not caps:
            if ctypes.get_errno() not in (0, errno.ENODATA):
                raise RuntimeError('Could not read Sunshine file capabilities.')
            caps = lib.cap_init()
        if not caps:
            raise RuntimeError('Could not initialize Sunshine file capabilities.')
        try:
            capability = ctypes.c_int(21)  # CAP_SYS_ADMIN
            if lib.cap_set_flag(caps, 1, 1, ctypes.byref(capability), 1) != 0 or lib.cap_set_fd(descriptor, caps) != 0:
                raise RuntimeError('Could not grant Sunshine KMS capability: ' + os.strerror(ctypes.get_errno()))
        finally:
            lib.cap_free(caps)
        verified = lib.cap_get_fd(descriptor)
        if not verified:
            raise RuntimeError('Could not verify Sunshine KMS capability.')
        try:
            flag = ctypes.c_int()
            if lib.cap_get_flag(verified, 21, 1, ctypes.byref(flag)) != 0 or flag.value != 1:
                raise RuntimeError('Sunshine KMS capability verification failed.')
        finally:
            lib.cap_free(verified)
        current = path.stat()
        if (current.st_dev, current.st_ino) != (device, inode):
            raise RuntimeError('Sunshine was replaced during authorization. Click Start again.')
    finally:
        os.close(descriptor)
    return {'success': True, 'message': 'Sunshine KMS permission is configured.'}


def command_path(*candidates):
    for candidate in candidates:
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def command_result(command):
    try:
        return subprocess.run(command, text=True, capture_output=True, check=False,
                              timeout=20, env={**os.environ, 'LC_ALL': 'C'})
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise RuntimeError(f"Could not complete {command[0]}: {exc}") from exc


def run(command):
    result = command_result(command)
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or "command failed"
        raise RuntimeError(f"{' '.join(command[:2])}: {detail}")
    return result.stdout


def invoking_user():
    raw_uid = os.environ.get("PKEXEC_UID", "")
    if not raw_uid.isdigit():
        raise RuntimeError("This helper must be started through polkit.")
    try:
        return pwd.getpwuid(int(raw_uid)).pw_name
    except KeyError as exc:
        raise RuntimeError("The authorizing user no longer exists.") from exc


def recovery_module():
    import importlib.util
    path=Path(__file__).resolve().parent/'system_recovery.py'
    spec=importlib.util.spec_from_file_location('monitorize_system_recovery',path)
    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
    return module


def ensure_input_assets():
    recovery_module().restore_asset('uinput.rules')
    try:grp.getgrnam('monitorize-input')
    except KeyError:
        groupadd=command_path('/usr/sbin/groupadd','/usr/bin/groupadd')
        if not groupadd:raise RuntimeError('The group-management dependency is missing.')
        run([groupadd,'--system','monitorize-input'])


def prepare_input_device():
    """Refresh the packaged rule and verify the device; never broaden its mode."""
    ensure_input_assets()
    # The packaged static node may exist even when no uinput driver is loaded.
    modprobe = command_path('/usr/sbin/modprobe', '/usr/bin/modprobe', '/sbin/modprobe')
    if not modprobe:
        raise RuntimeError('modprobe is not installed. Repair the Monitorize package dependencies.')
    run([modprobe, 'uinput'])
    udevadm = command_path('/usr/bin/udevadm', '/usr/sbin/udevadm', '/bin/udevadm')
    if not udevadm:
        raise RuntimeError('udevadm is not installed. Repair the Monitorize package dependencies.')
    run([udevadm, 'control', '--reload-rules'])
    run([udevadm, 'trigger', '--action=add', '--subsystem-match=misc', '--sysname-match=uinput'])
    run([udevadm, 'settle', '--timeout=5'])
    try:
        node = Path('/dev/uinput').stat()
        group = grp.getgrnam('monitorize-input')
    except (OSError, KeyError) as exc:
        raise RuntimeError('The uinput device or monitorize-input group is missing. Repair the Monitorize package installation.') from exc
    if not stat.S_ISCHR(node.st_mode) or node.st_gid != group.gr_gid or node.st_mode & 0o060 != 0o060:
        raise RuntimeError('The uinput device does not grant monitorize-input read/write access. Check for conflicting udev rules and repair the Monitorize package installation.')
    try:
        descriptor = os.open('/dev/uinput', os.O_WRONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        os.close(descriptor)
    except OSError as exc:
        raise RuntimeError(f'The uinput driver is not usable: {exc}') from exc


def enable_input(username):
    ensure_input_assets()
    try:
        group = grp.getgrnam("monitorize-input")
        user = pwd.getpwnam(username)
    except KeyError as exc:
        raise RuntimeError("The monitorize-input group is not installed.") from exc
    prepare_input_device()
    if user.pw_gid == group.gr_gid or username in group.gr_mem:
        return True, "Input permission is configured. Log out and back in if this session cannot use input yet."
    usermod = command_path("/usr/sbin/usermod", "/usr/bin/usermod")
    if not usermod:
        raise RuntimeError("usermod is not available.")
    run([usermod, "-aG", "monitorize-input", username])
    return True, "Input permission configured. Log out and back in to use it."


def enable_firewall():
    firewall_cmd = command_path('/usr/bin/firewall-cmd', '/usr/sbin/firewall-cmd')
    if firewall_cmd:
        state = command_result([firewall_cmd, '--state'])
        if state.returncode not in (0, 252):
            raise RuntimeError('Could not check firewalld status: ' + (state.stderr.strip() or state.stdout.strip() or 'unknown error'))
        if state.returncode == 0:
            if 'monitorize' not in run([firewall_cmd, '--permanent', '--get-services']).split():
                # A source install can add the XML after firewalld was started.
                run([firewall_cmd, '--reload'])
                if 'monitorize' not in run([firewall_cmd, '--permanent', '--get-services']).split():
                    recovery_module().restore_asset('firewalld.xml')
                    run([firewall_cmd,'--reload'])
                    if 'monitorize' not in run([firewall_cmd,'--permanent','--get-services']).split():
                        raise RuntimeError('The Monitorize firewall profile could not be registered.')
            active = run([firewall_cmd, '--get-active-zones'])
            zones = list(dict.fromkeys(line.split()[0] for line in active.splitlines()
                                      if line.strip() and not line[0].isspace()))
            if not zones:
                zones = run([firewall_cmd, '--get-default-zone']).split()
            if not zones:
                raise RuntimeError('Could not determine a firewalld zone for Monitorize.')
            for zone in zones:
                for scope in (['--permanent'], []):
                    command = [firewall_cmd, *scope, '--zone=' + zone]
                    run([*command, '--add-service=monitorize'])
                    if run([*command, '--query-service=monitorize']).strip() != 'yes':
                        raise RuntimeError('Could not verify the Monitorize firewall rule in zone ' + zone + '.')
            return 'Firewalld now allows Monitorize in zones: ' + ', '.join(zones) + '.'

    ufw = command_path('/usr/sbin/ufw', '/usr/bin/ufw')
    if ufw:
        state = command_result([ufw, 'status'])
        if state.returncode:
            raise RuntimeError('Could not check UFW status: ' + (state.stderr.strip() or state.stdout.strip() or 'unknown error'))
        lines = state.stdout.splitlines()
        if 'Status: active' in lines:
            recovery_module().restore_asset('ufw.profile')
            run([ufw, 'allow', 'Monitorize'])
            rules = run([ufw, 'status'])
            if not any(line.split() and line.split()[0] == 'Monitorize' and 'ALLOW' in line.split() for line in rules.splitlines()):
                raise RuntimeError('Could not verify the Monitorize UFW rule.')
            return 'UFW now allows Monitorize.'
        if 'Status: inactive' not in lines:
            raise RuntimeError('Could not recognize UFW status; no rules were changed.')
    return 'No active supported firewall was detected; no firewall changes were needed.'


def main():
    parser = argparse.ArgumentParser(description="Configure Monitorize input and firewall access.")
    parser.add_argument("--recover-networkmanager",action="store_true")
    parser.add_argument("--recover-host",action="store_true")
    parser.add_argument("--restart-host",action="store_true")
    parser.add_argument("--input", action="store_true", help="grant the authorizing user uinput access")
    parser.add_argument("--firewall", action="store_true", help="allow Monitorize through an active firewall")
    parser.add_argument('--unattended-vkms', action='store_true')
    parser.add_argument('--remote-login', choices=('enable','enable-live','disable','recover','recover-disable','remove','fallback','primary-on','primary-off','login-virtual-on','login-virtual-off','timeout'))
    parser.add_argument('--display-idle-timeout', type=int, choices=range(1,601), metavar='SECONDS')
    parser.add_argument('--kms-binary')
    parser.add_argument('--kms-device', type=int)
    parser.add_argument('--kms-inode', type=int)
    args = parser.parse_args()
    if not args.restart_host and not args.recover_host and not args.recover_networkmanager and not args.input and not args.firewall and not args.unattended_vkms and not args.remote_login and not args.kms_binary:
        parser.error("select --input, --firewall and/or --unattended-vkms")
    if os.geteuid() != 0:
        raise RuntimeError("This helper requires root privileges.")

    if args.recover_host or args.restart_host:
        if (args.recover_host and args.restart_host) or args.recover_networkmanager or args.input or args.firewall or args.remote_login or args.kms_binary or args.unattended_vkms or args.kms_device is not None or args.kms_inode is not None or args.display_idle_timeout is not None:
            parser.error('Host recovery is a separate action.')
        invoking_user()
        result=recovery_module().recover_host(restart_only=True) if args.restart_host else recovery_module().recover_host()
        print(json.dumps(result));raise SystemExit(0 if result.get('success') else 1)

    if args.recover_networkmanager:
        if args.input or args.firewall or args.remote_login or args.kms_binary or args.unattended_vkms or args.kms_device is not None or args.kms_inode is not None or args.display_idle_timeout is not None:
            parser.error('Network recovery is a separate action.')
        invoking_user()
        print(json.dumps(recovery_module().start_networkmanager(run)));return

    if args.kms_binary:
        if (args.input or args.firewall or args.unattended_vkms or args.remote_login
                or args.display_idle_timeout is not None
                or args.kms_device is None or args.kms_inode is None):
            parser.error('KMS permission repair is a separate operation requiring a file identity.')
        print(json.dumps(grant_kms_capability(args.kms_binary, args.kms_device, args.kms_inode)))
        return
    if args.kms_device is not None or args.kms_inode is not None:
        parser.error('A KMS file identity requires --kms-binary.')

    if (args.display_idle_timeout is not None) != (args.remote_login == 'timeout'):
        parser.error('--display-idle-timeout requires --remote-login timeout')
    if args.remote_login:
        if args.input or args.firewall or args.unattended_vkms:
            parser.error("Remote-login enrollment is a separate setup operation.")
        invoking_user()
        entry = Path('/usr/libexec/monitorize/remote-login/entry.py')
        if not entry.is_file():
            raise RuntimeError('Install Monitorize remote-login service assets first.')
        command=[sys.executable, '-I', str(entry), 'setup-' + args.remote_login]
        if args.remote_login=='timeout':command.append(str(args.display_idle_timeout))
        result = subprocess.run(command,
                                check=False, text=True, capture_output=True)
        print(result.stdout.strip())
        if result.returncode:
            if result.stderr.strip():
                print(result.stderr.strip(), file=sys.stderr)
            raise SystemExit(result.returncode)
        return

    host_authorization = Path('/usr/libexec/monitorize-vkms/monitorize-vkms-authorization')
    if args.unattended_vkms and not host_authorization.is_file():
        raise RuntimeError('Install or upgrade monitorize-vkms before enabling unattended displays.')
    username = invoking_user()
    messages = []
    logout_required = False
    actions = {}
    action = None
    try:
        if args.unattended_vkms:
            action = 'vkms'
            response = json.loads(run([sys.executable, '-I', str(host_authorization), 'enable']))
            if not response.get('success'):
                raise RuntimeError(response.get('message') or 'Could not authorize VKMS displays.')
            messages.append(response['message'])
            actions[action] = {'success': True, 'message': response['message']}
        if args.input:
            action = 'input'
            input_changed, input_message = enable_input(username)
            messages.append(input_message)
            logout_required = input_changed
            actions[action] = {'success': True, 'message': input_message}
        if args.firewall:
            action = 'firewall'
            message = enable_firewall()
            messages.append(message)
            actions[action] = {'success': True, 'message': message}
    except Exception as exc:
        if action:
            actions[action] = {'success': False, 'message': str(exc)}
        detail = ' '.join(messages + [str(exc)])
        print(json.dumps({'success': False, 'message': detail, 'logout_required': logout_required, 'actions': actions}))
        print(detail, file=sys.stderr)
        raise SystemExit(1)
    print(json.dumps({"success": True, "message": " ".join(messages), "logout_required": logout_required, "actions": actions}))



if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, ValueError) as exc:
        print(json.dumps({"success": False, "message": str(exc)}))
        sys.exit(1)
