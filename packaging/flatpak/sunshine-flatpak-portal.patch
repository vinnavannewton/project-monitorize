+  /**
+   * @brief Persistent VIRTUAL portal session manager.
+   *
+   * Maintains ONE long-lived RemoteDesktop + ScreenCast(types=VIRTUAL) session
+   * across multiple encoder probing passes and active streaming sessions.
+   * Only closes the portal session on Sunshine process shutdown.
+   */
+  class persistent_virtual_session_t {
+  public:
+    int ensure_ready() {
+      std::lock_guard lock(mutex_);
+      if (ready_) {
+        return 0;
+      }
+      BOOST_LOG(info) << "[portal-virtual] Creating persistent VIRTUAL session"sv;
+      dbus_ = std::make_unique<dbus_t>();
+      if (dbus_->init() < 0) {
+        BOOST_LOG(error) << "[portal-virtual] Failed to init D-Bus connection for virtual session"sv;
+        dbus_.reset();
+        return -1;
+      }
+      if (dbus_->connect_to_portal() < 0) {
+        BOOST_LOG(error) << "[portal-virtual] Failed to connect to portal for virtual session"sv;
+        dbus_.reset();
+        return -1;
+      }
+      if (dbus_->pipewire_streams.empty()) {
+        BOOST_LOG(error) << "[portal-virtual] No streams returned for virtual session"sv;
+        dbus_.reset();
+        return -1;
+      }
+      selected_stream_ = dbus_->pipewire_streams.front();
+      for (const auto &s : dbus_->pipewire_streams) {
+        if (s.source_type == SOURCE_TYPE_VIRTUAL) {
+          selected_stream_ = s;
+          break;
+        }
+      }
+      ready_ = true;
+      BOOST_LOG(info) << "[portal-virtual] KDE virtual portal session READY (node_id="sv
+                      << selected_stream_.pipewire_node << " serial=" << selected_stream_.pipewire_object_serial << ")"sv;
+      return 0;
+    }
+
+    int open_pipewire_remote(int &out_fd) {
+      std::lock_guard lock(mutex_);
+      if (!ready_ || !dbus_) {
+        BOOST_LOG(error) << "[portal-virtual] Cannot open PipeWire remote: session not ready"sv;
+        return -1;
+      }
+      BOOST_LOG(info) << "[portal-virtual] Opening new PipeWire remote for capture"sv;
+      return dbus_->open_pipewire_remote(out_fd);
+    }
+
+    const pipewire_streaminfo_t &stream() const {
+      return selected_stream_;
+    }
+
+    std::string display_name() const {
+      std::lock_guard lock(mutex_);
+      return selected_stream_.to_display_name();
+    }
+
+    void shutdown() {
+      std::lock_guard lock(mutex_);
+      if (dbus_) {
+        BOOST_LOG(info) << "[portal-virtual] Closing persistent VIRTUAL portal session"sv;
+        dbus_.reset();
+        ready_ = false;
+        BOOST_LOG(info) << "[portal-virtual] VIRTUAL session closed"sv;
+      }
+    }
+
+    ~persistent_virtual_session_t() {
+      shutdown();
+    }
+
+  private:
+    mutable std::mutex mutex_;
+    std::unique_ptr<dbus_t> dbus_;
+    pipewire_streaminfo_t selected_stream_;
+    bool ready_ = false;
+  };
+
+  static persistent_virtual_session_t &get_persistent_virtual_session() {
+    static persistent_virtual_session_t session;
+    static std::once_flag atexit_flag;
+    std::call_once(atexit_flag, []() {
+      std::atexit([]() {
+        get_persistent_virtual_session().shutdown();
